+	private function parseContainer() {
+		if ( $this->MatchReg( '/\\G@container/' ) ) {
+			$this->save();
+
+			$features = $this->parseMediaFeatures();
+			$rules = $this->parseBlock();
+
+			if ( $rules === null ) {
+				$this->restore();
+				return;
+			}
+
+			$this->forget();
+			return $this->NewObj( 'Less_Tree_Container', [ $rules, $features, $this->pos, $this->env->currentFileInfo ] );
