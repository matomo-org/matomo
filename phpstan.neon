includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    phpVersion: 80100
    paths:
        - core
        - plugins
    excludePaths:
        - plugins/*/tests/*
        # TODO: revisit after the monolog 3 upgrade. The symfony/monolog-bridge ConsoleFormatter
        # is @final and its version-conditional CompatibilityFormatter trait resolves to the
        # monolog 3 LogRecord signature under static analysis, while monolog 1.x is installed.
        - plugins/Monolog/Formatter/ConsoleFormatter.php
        - plugins/ScheduledReports/config/tcpdf_config.php
        - plugins/AnonymousPiwikUsageMeasurement
        - plugins/Bandwidth
        - plugins/CustomAlerts
        - plugins/CustomVariables
        - plugins/DeviceDetectorCache
        - plugins/LogViewer
        - plugins/LoginLdap
        - plugins/MarketingCampaignsReporting
        - plugins/Provider
        - plugins/QueuedTracking
        - plugins/SecurityInfo
        - plugins/TagManager
        - plugins/TasksTimetable
        - plugins/TrackingSpamPrevention
        - plugins/TreemapVisualization
        - plugins/VisitorGenerator
    bootstrapFiles:
        - bootstrap-phpstan.php
    ignoreErrors:
        - "#Unsafe usage of new static#"
    universalObjectCratesClasses:
        - Piwik\Config
        - Piwik\View
        - Piwik\ViewDataTable\Config
        - Piwik\Session\SessionNamespace
