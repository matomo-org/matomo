{% extends 'admin.twig' %}

{% block content %}
{# ClickHouse POC (DEV-20678) connection check, screenshot-asserted by
   tests/UI/ClickHouseStatus_spec.js. Dynamic values (server version, error details) stay
   OUTSIDE #clickHouseStatus so the expected screenshot remains stable across ClickHouse
   image bumps. Strings intentionally untranslated: dev/POC-only surface. #}
<div class="card">
    <div class="card-content">
        <h2 class="card-title">ClickHouse</h2>
        <div id="clickHouseStatus">
            {% if connected %}
                <p><strong>Status:</strong> <span style="color: #1e7e34; font-weight: bold;">Connected</span></p>
                <p><strong>Round trip:</strong> CREATE TABLE &#8594; INSERT &#8594; SELECT returned "{{ roundTrip }}"</p>
            {% else %}
                <p><strong>Status:</strong> <span style="color: #c62828; font-weight: bold;">Not connected</span></p>
                {# TEMP DEBUG: surface the failure reason in the screenshot; remove once CI connects #}
                {% if error %}<pre style="white-space: pre-wrap;">{{ error }}</pre>{% endif %}
                {% if roundTrip %}<p>roundTrip: {{ roundTrip }}</p>{% endif %}
                {% if serverVersion %}<p>version: {{ serverVersion }}</p>{% endif %}
            {% endif %}
        </div>
        {% if serverVersion %}
            <p>Server version: {{ serverVersion }}</p>
        {% endif %}
        {% if error %}
            <pre>{{ error }}</pre>
        {% endif %}
    </div>
</div>
{% endblock %}
