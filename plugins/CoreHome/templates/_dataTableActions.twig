{# The report's actions are rendered once, by the menu its header hosts. This carries the config
   that menu renders from, as data rather than as a second DataTableActions app: the header sits
   outside `.dataTable`, so an ajax reload has to bring fresh values in with the replaced table.
   dataTable.js reads it and publishes it - see _readReportActionsConfig().
   `actionTranslations` is named as the header names it: `translations` there would shadow the
   translate() helper inside the component. #}
{% set reportActionsConfig = {
    'showFooter': properties.show_footer,
    'showFooterIcons': properties.show_footer_icons,
    'footerIcons': footerIcons,
    'viewDataTable': clientSideParameters.viewDataTable,
    'clientSideParameters': clientSideParameters,
    'isDataTableEmpty': isDataTableEmpty,
    'showFlattenTable': properties.show_flatten_table,
    'reportSupportsFlatten': properties.report_supports_flatten,
    'reportSupportsPercentageValues': properties.report_supports_percentage_values|default(false),
    'exportSupportsFlatten': properties.show_flatten_table_export,
    'hasMultipleDimensions': hasMultipleDimensions|default(false),
    'showTotalsRow': properties.show_totals_row|default(false),
    'showExcludeLowPopulation': properties.show_exclude_low_population|default(false),
    'showPivotBySubtable': (properties.show_pivot_by_subtable|default(false) and not isComparing|default(false)),
    'dataTableActions': properties.datatable_actions|default([]),
    'showExport': properties.show_export,
    'showExportAsImageIcon': properties.show_export_as_image_icon,
    'showAnnotations': (isPluginLoaded('Annotations') and not properties.hide_annotations_view),
    'showPeriods': properties.show_periods|default(false),
    'selectablePeriods': properties.selectable_periods|default([]),
    'requestParams': (properties.request_parameters_to_modify|default({}))|merge(properties.export_parameters_to_modify|default({})),
    'maxFilterLimit': properties.max_export_filter_limit,
    'apiMethodToRequestDataTable': properties.apiMethodToRequestDataTable,
    'pivotDimensionName': properties.pivot_dimension_name|default(null),
    'showSearch': properties.show_search,
    'actionTranslations': properties.translations|default({})
} %}
<div class="reportActionsConfig" data-report-actions="{{ reportActionsConfig|json_encode|e('html_attr') }}"></div>
