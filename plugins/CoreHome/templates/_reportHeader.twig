{# `inCard` is what separates the two kinds of full-page report: one shown as a content block
   carries the help icon and rating and matches the card title, one shown without a card had
   only a plain `h2` and neither.

   Attributes are emitted even when empty: compileVueEntryComponents builds the component's
   template from the ones present here, so an omitted attribute could not be set later either -
   and dataTable.js sets the title and help on this app when a related report is loaded. #}
{% set isInCard = inCard|default(false) %}
{# defined but null when the report has no archived-on date, and `null` would reach the component
   as a value distinct from '' and render an empty date #}
{% set lastUpdated = reportLastUpdatedMessage is defined and reportLastUpdatedMessage ? reportLastUpdatedMessage : '' %}
<div vue-entry="CoreHome.ReportHeader"
     context="{{ context|default('fullPage') }}"
     show-title="{{ (showTitle is defined ? showTitle : true)|json_encode }}"
     heading-level="h2"
     report-title="{{ properties.title|json_encode }}"
     enriched="{{ isInCard|json_encode }}"
     plain-title="{{ (not isInCard and (context|default('fullPage')) == 'fullPage')|json_encode }}"
     feature-name="{{ ''|json_encode }}"
     inline-help="{{ (isInCard ? properties.documentation|default('') : '')|json_encode }}"
     help-url="{{ (isInCard ? properties.onlineGuideUrl|default('')|safelink : '')|json_encode }}"
     report-generated="{{ (isInCard ? lastUpdated : '')|json_encode }}"
     edit-url="{{ (isInCard ? properties.title_edit_entity_url|default('') : '')|json_encode }}"
     show-search="{{ properties.show_search|default(false)|json_encode }}"
     search-query="{{ ''|json_encode }}"
     {# an errored report renders the alert instead of _dataTableJS.twig, so nothing binds the
        actions: offering them would open a menu that cannot act #}
     show-footer="{{ (properties.show_footer|default(false) and error is not defined)|json_encode }}"
     show-footer-icons="{{ (properties.show_footer_icons|default(false) and error is not defined)|json_encode }}"
     footer-icons="{{ footerIcons|default([])|json_encode }}"
     request-params="{{ (properties.request_parameters_to_modify|default({}))|merge(properties.export_parameters_to_modify|default({}))|json_encode }}"
     api-method-to-request-data-table="{{ properties.apiMethodToRequestDataTable|default('')|json_encode }}"
     max-filter-limit="{{ properties.max_export_filter_limit|default(0)|json_encode }}"
     show-export="{{ properties.show_export|default(false)|json_encode }}"
     show-export-as-image-icon="{{ properties.show_export_as_image_icon|default(false)|json_encode }}"
     report-id="{{ properties.report_id|default('')|json_encode }}"
     data-table-actions="{{ properties.datatable_actions|default([])|json_encode }}"
     show-flatten-table="{{ properties.show_flatten_table|default(false)|json_encode }}"
     report-supports-flatten="{{ properties.report_supports_flatten|default(false)|json_encode }}"
     report-supports-percentage-values="{{ properties.report_supports_percentage_values|default(false)|json_encode }}"
     export-supports-flatten="{{ properties.show_flatten_table_export|default(false)|json_encode }}"
     client-side-parameters="{{ clientSideParameters|default({})|json_encode }}"
     has-multiple-dimensions="{{ hasMultipleDimensions|default(false)|json_encode }}"
     is-data-table-empty="{{ isDataTableEmpty|default(false)|json_encode }}"
     show-totals-row="{{ properties.show_totals_row|default(false)|json_encode }}"
     show-exclude-low-population="{{ properties.show_exclude_low_population|default(false)|json_encode }}"
     show-pivot-by-subtable="{{ (properties.show_pivot_by_subtable|default(false) and not isComparing|default(false))|json_encode }}"
     action-translations="{{ properties.translations|default({})|json_encode }}"
     view-data-table="{{ clientSideParameters.viewDataTable|default('')|json_encode }}"
     pivot-dimension-name="{{ properties.pivot_dimension_name|default(null)|json_encode }}"
     selectable-periods="{{ properties.selectable_periods|default([])|json_encode }}"
></div>
