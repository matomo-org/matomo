<div id="widgetTemplate" style="display:none;" vue-entry-ignore>
    {# `__reportHeader-onHover` is the ReportHeader context hook: it marks this widget as the
       hover scope, so hovering anywhere on it reveals the header controls (see ReportHeader.less). #}
    <div class="widget __reportHeader-onHover">
        {# .widgetTop stays as the drag handle (see dashboardObject.js sortable `handle`).
           Its title + controls are rendered by the shared ReportHeader Vue component,
           hydrated per-widget in dashboardWidget.js with the widget name + context. #}
        <div class="widgetTop">
            {# declared (even empty) so dataTable.js can set them later, see compileVueEntryComponents #}
            <div vue-entry="CoreHome.ReportHeader"
                 context="dashboard"
                 show-search="{{ false|json_encode }}"
                 search-query="{{ ''|json_encode }}"
                 show-footer="{{ false|json_encode }}"
                 show-footer-icons="{{ false|json_encode }}"
                 footer-icons="{{ []|json_encode }}"
                 client-side-parameters="{{ {}|json_encode }}"
                 view-data-table="{{ ''|json_encode }}"
                 request-params="{{ {}|json_encode }}"
                 api-method-to-request-data-table="{{ ''|json_encode }}"
                 max-filter-limit="{{ 0|json_encode }}"
                 show-export="{{ false|json_encode }}"
                 show-export-as-image-icon="{{ false|json_encode }}"
                 data-table-actions="{{ []|json_encode }}"
                 show-flatten-table="{{ false|json_encode }}"
                 report-supports-flatten="{{ false|json_encode }}"
                 report-supports-percentage-values="{{ false|json_encode }}"
                 export-supports-flatten="{{ false|json_encode }}"
                 has-multiple-dimensions="{{ false|json_encode }}"
                 is-data-table-empty="{{ false|json_encode }}"
                 show-totals-row="{{ false|json_encode }}"
                 show-exclude-low-population="{{ false|json_encode }}"
                 show-pivot-by-subtable="{{ false|json_encode }}"
                 pivot-dimension-name="{{ null|json_encode }}"
                 show-annotations="{{ false|json_encode }}"
                 annotations-showing="{{ false|json_encode }}"
                 show-periods="{{ false|json_encode }}"
                 selectable-periods="{{ []|json_encode }}"
                 action-translations="{{ {}|json_encode }}"
                 report-id="{{ ''|json_encode }}"
                 report-key="{{ ''|json_encode }}"
            ></div>
        </div>
        <div class="widgetContent">
            <div class="widgetLoading">{{ 'Dashboard_LoadingWidget'|translate }}</div>
        </div>
    </div>
</div>
