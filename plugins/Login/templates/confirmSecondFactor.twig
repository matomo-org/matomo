{% extends '@Login/loginLayout.twig' %}

{% set title %}{{ 'Login_ConfirmSecondFactorToContinue'|translate }}{% endset %}

{% block loginContent %}
    <div class="contentForm loginForm confirmSecondFactorForm">
        {% embed 'contentBlock.twig' with {'title': ('Login_ConfirmSecondFactorToContinue'|translate)} %}
        {% block content %}

            <div class="message_container">
                {% if AccessErrorString %}
                    <div vue-entry="CoreHome.Notification"
                         noclear="true"
                         context="error">
                        <strong>{{ 'General_Error'|translate }}</strong>: {{ AccessErrorString|raw }}<br/>
                    </div>
                {% endif %}
            </div>

            <p>{{ 'Login_ConfirmSecondFactorIntro'|translate }}</p>

            <form id="confirm_second_factor_form"
                  action="{{ linkTo({'module': confirmModule, 'action': 'confirmSecondFactor', 'secondFactorRequest': requestId})|e('html_attr') }}" method="post">
                <div class="row">
                    <div class="col s12 input-field">
                        <input type="hidden" name="nonce" id="second_factor_form_nonce" value="{{ nonce|e('html_attr') }}"/>
                        <input type="text" placeholder="" name="code" id="second_factor_form_code" class="input" value=""
                               autocomplete="one-time-code" autocorrect="off" autocapitalize="none" spellcheck="false"
                               tabindex="20" autofocus required />
                        <label for="second_factor_form_code"><i class="icon-locked icon"></i> {{ 'Login_SecondFactorCode'|translate }}</label>
                    </div>
                </div>

                <div class="row actions">
                    <div class="col s12">
                        <input class="submit btn" id="second_factor_form_submit" type="submit" value="{{ 'General_Confirm'|translate }}"
                               tabindex="100"/>
                    </div>
                </div>

            </form>

        {% endblock %}
        {% endembed %}
    </div>

{% endblock %}
