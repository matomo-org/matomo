{% set instanceLinkOpen = '<a href="' ~ instanceLink ~'">' %}
{% set instanceLinkClose = '</a>' %}
{% set pluginLinkOpen = '<a href="' ~ pluginLink ~'">' %}
{% set pluginLinkClose = '</a>' %}

<p>{{ 'General_HelloUser'|translate(login) }}</p>
{% if isInstallRequest %}
<p>{{ 'Marketplace_RequestInstallNotificationEmailIntro'|translate(pluginName) }}</p>
<p>{{ 'Marketplace_RequestInstallNotificationEmailHowToInstallIntro'|translate }}</p>
{% else %}
<p>{{ 'Marketplace_RequestTrialNotificationEmailIntro'|translate(pluginName) }}</p>
<p>{{ 'Marketplace_RequestTrialNotificationEmailHowToStartIntro'|translate }}</p>
{% endif %}
<ol>
    <li>{{ 'Marketplace_RequestTrialNotificationEmailHowToStartStep1'|translate(instanceLinkOpen, instanceLinkClose)|raw }}</li>
{% if linksToManageRequests %}
    <li>{{ 'Marketplace_RequestTrialNotificationEmailManageRequestsStep2'|translate(pluginName) }}</li>
    <li>{{ 'Marketplace_RequestTrialNotificationEmailManageRequestsStep3'|translate }}</li>
{% else %}
    <li>{{ 'Marketplace_RequestTrialNotificationEmailHowToStartStep2'|translate }}</li>
    <li>{{ (isInstallRequest ? 'Marketplace_RequestInstallNotificationEmailHowToInstallStep3' : 'Marketplace_RequestTrialNotificationEmailHowToStartStep3')|translate }}</li>
{% endif %}
</ol>
<p>{{ 'Marketplace_RequestTrialNotificationEmailMoreInfo'|translate(pluginName|escape, pluginLinkOpen, pluginLinkClose)|raw }}</p>
