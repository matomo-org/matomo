{% extends '@Morpheus/componentLibrary/_layout.twig' %}
{% import '@Morpheus/componentLibrary/_macros.twig' as library %}

{% block componentPage %}

<h1 class="componentLibrary__title">Selector <code>.mtm-selector</code></h1>
<p class="componentLibrary__summary">
    A control that shows the current choice and opens a panel to change it: the website, period,
    segment and dashboard selectors at the top of a page, the export and period pickers of a report.
</p>

<table class="componentLibrary__table">
    <tr>
        <th>Use it for</th>
        <td>A choice, or a set of actions, that opens in a panel under the control.</td>
    </tr>
    <tr>
        <th>Use something else for</th>
        <td>
            A single action with nothing to choose: a button (<code>.btn</code>).
            A choice inside a form: the form field of the matching type.
        </td>
    </tr>
    <tr>
        <th>Source</th>
        <td>
            <code>plugins/Morpheus/stylesheets/ui/_selector.less</code> for the control,
            <code>plugins/Morpheus/stylesheets/ui/_dropdown-panel.less</code> for its panel,
            <code>plugins/CoreHome/vue/src/Selector/useSelectorDropdown.ts</code> for its behaviour.
        </td>
    </tr>
</table>

{# ------------------------------------------------------------------------------------------- #}

<section class="componentLibrary__section">
    <h2 class="componentLibrary__sectionTitle">Anatomy</h2>
    <p>
        One framed row: an optional action at its start, the trigger, an optional action at its end.
        The panel is placed right after the trigger in the markup, so the keyboard reaches it before
        the end action.
    </p>

    <table class="componentLibrary__table">
        <tr><th>Part</th><th>Class</th><th>Required</th><th>Notes</th></tr>
        <tr><td>Block</td><td><code>mtm-selector</code></td><td>yes</td><td>Draws the frame. The consumer places it.</td></tr>
        <tr><td>Trigger</td><td><code>mtm-selector__trigger</code></td><td>yes</td><td>A <code>&lt;button type="button"&gt;</code>, or a link when it navigates.</td></tr>
        <tr><td>Icon</td><td><code>mtm-selector__icon</code></td><td>no</td><td>Wraps an icon font glyph, before the label.</td></tr>
        <tr><td>Label</td><td><code>mtm-selector__label</code></td><td>no</td><td>The current choice. Ellipsised when the control is too narrow.</td></tr>
        <tr><td>Dropdown arrow</td><td><code>mtm-selector__rightIcon</code></td><td>no</td><td>Turns over while the panel is open.</td></tr>
        <tr><td>Panel</td><td><code>mtm-selector__dropdown</code></td><td>no</td><td>Positions the panel; holds a <code>mtm-dropdownPanel</code> that draws it.</td></tr>
        <tr><td>Start action</td><td><code>mtm-selector__action mtm-selector__action--start</code></td><td>no</td><td>A one-click button before the trigger.</td></tr>
        <tr><td>End action</td><td><code>mtm-selector__action mtm-selector__action--end</code></td><td>no</td><td>A one-click button after the panel.</td></tr>
    </table>

    {% set anatomy %}
<div class="mtm-selector">
  <button type="button" class="mtm-selector__action mtm-selector__action--start" aria-label="Previous period">
    <span class="mtm-selector__icon" aria-hidden="true"><span class="icon-chevron-left"></span></span>
  </button>
  <button type="button" class="mtm-selector__trigger">
    <span class="mtm-selector__icon" aria-hidden="true"><span class="icon-calendar"></span></span>
    <span class="mtm-selector__label">2012</span>
    <span class="mtm-selector__rightIcon" aria-hidden="true"><span class="icon-chevron-down"></span></span>
  </button>
  <div class="mtm-selector__dropdown">
    <div class="mtm-dropdownPanel">…</div>
  </div>
  <button type="button" class="mtm-selector__action mtm-selector__action--end" aria-label="Next period">
    <span class="mtm-selector__icon" aria-hidden="true"><span class="icon-chevron-right"></span></span>
  </button>
</div>
    {% endset %}
    {{ library.example('anatomy', 'Every part', '', anatomy) }}
</section>

{# ------------------------------------------------------------------------------------------- #}

