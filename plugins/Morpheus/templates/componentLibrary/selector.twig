<section class="componentLibrary__section">
    <h2 class="componentLibrary__sectionTitle">Behaviour and accessibility</h2>
    <ul class="componentLibrary__list">
        <li>
            The keyboard walks the start action, the trigger, the open panel, then the end action.
            Keep that order in the markup and give the three buttons the same <code>tabindex</code>.
        </li>
        <li>Name an action, or an icon-only trigger, with an <code>aria-label</code>: it shows no text.</li>
        <li>
            The trigger carries <code>aria-haspopup</code> and <code>aria-expanded</code>; in Vue,
            <code>triggerProps()</code> sets both.
        </li>
        <li>
            Escape closes the panel and gives the focus back to the trigger. Arrow keys, Home and End
            walk a menu or a list panel.
        </li>
    </ul>

    <p>In a Vue component, <code>useSelectorDropdown()</code> from CoreHome brings all of it:</p>
    {% set vueUsage %}
<template>
  <div ref="root" class="mtm-selector" v-expand-on-click="binding">
    <button ref="trigger" type="button" class="mtm-selector__trigger" v-bind="selector.triggerProps()">
      <span class="mtm-selector__label">Export</span>
    </button>
    <div class="mtm-selector__dropdown" @keydown="selector.onKeydown">
      <div class="mtm-dropdownPanel">…</div>
    </div>
  </div>
</template>

<script lang="ts">
import { defineComponent } from 'vue';
import { ExpandOnClick, useSelectorDropdown } from 'CoreHome';

export default defineComponent({
  directives: { ExpandOnClick },
  created() {
    this.selector = useSelectorDropdown(
      { role: 'menu', expandedClass: 'mtm-selector--expanded' },
      () => this.$refs.root as HTMLElement | null,
      () => this.$refs.trigger as HTMLElement | null,
    );
    this.binding = this.selector.expandBinding('trigger');
  },
});
</script>
    {% endset %}
    <pre class="componentLibrary__code"><code class="componentLibrary__codeText">{{ (vueUsage ~ '')|trim|e('html') }}</code></pre>
</section>

