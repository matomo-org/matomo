{# ------------------------------------------------------------------------------------------- #}

<section class="componentLibrary__section">
    <h2 class="componentLibrary__sectionTitle">States</h2>

    <table class="componentLibrary__table">
        <tr><th>State</th><th>Set by</th><th>Looks</th></tr>
        <tr><td>Closed</td><td>default</td><td>Grey frame.</td></tr>
        <tr><td>Hover</td><td>the pointer on the trigger</td><td>The whole frame turns blue.</td></tr>
        <tr><td>Keyboard focus</td><td><code>:focus-visible</code> on the trigger</td><td>A focus ring around the whole frame.</td></tr>
        <tr><td>Action hover, action focus</td><td>the pointer or the keyboard on an action</td><td>The ring is drawn around that action only.</td></tr>
        <tr><td>Open</td><td><code>mtm-selector--expanded</code> on the block</td><td>Blue frame, arrow turned over, panel shown.</td></tr>
        <tr><td>Loading</td><td><code>mtm-selector--loading</code> on the block</td><td>A spinner stands in for the icon.</td></tr>
        <tr><td>Disabled</td><td><code>mtm-selector--disabled</code>, and <code>disabled</code> on the trigger</td><td>Faded, ignores the pointer.</td></tr>
        <tr><td>Read only</td><td><code>mtm-selector--readOnly</code></td><td>Full strength, no hover: a single choice that opens nothing.</td></tr>
        <tr><td>Disabled action</td><td><code>disabled</code> on the action</td><td>Greyed glyph, no ring.</td></tr>
    </table>

    {{ library.example('hover', 'Hover', 'The pointer on the trigger frames the whole control, actions included.', bothActions, '', 'hover', '.mtm-selector__trigger') }}
    {{ library.example('focus', 'Keyboard focus', 'A 2px ring around the whole control.', bothActions, '', 'focus-visible', '.mtm-selector__trigger') }}
    {{ library.example('actionHover', 'Action hover', 'The ring stays on the action.', bothActions, '', 'hover', '.mtm-selector__action--start') }}
    {{ library.example('actionFocus', 'Action keyboard focus', '', bothActions, '', 'focus-visible', '.mtm-selector__action--end') }}

