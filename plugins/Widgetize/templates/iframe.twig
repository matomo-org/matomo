<!DOCTYPE html>
<html id="ng-app">
    <head>
        <meta charset="utf-8">
        <meta name="robots" content="noindex,nofollow">
        <meta name="google" content="notranslate">
        {% include "_jsGlobalVariables.twig" %}
        {% include "_jsCssIncludes.twig" %}
    </head>
    {% set bodyClass = postEvent('Template.bodyClass', 'widgetized') %}
    <body class="app-widgetized widgetized{{ bodyClass }}">
        {# `__reportHeader-onHover` is the ReportHeader context hook, carried here so the report's
           actions trigger darkens once the pointer is on the widget. It also overlays the actions
           on the title, which is why an embed promotes none of them out of the menu. #}
        <div class="widget __reportHeader-onHover">
            {{ content|raw }}
        </div>
        <div id="pageFooter">
            {{ postEvent('Template.pageFooter') }}
        </div>
    </body>
</html>
