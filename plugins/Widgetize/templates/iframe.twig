<!DOCTYPE html>
<html id="ng-app">
    <head>
        <meta charset="utf-8">
        <meta name="robots" content="noindex,nofollow">
        <meta name="google" content="notranslate">
        {% include "_jsGlobalVariables.twig" %}
        {% include "_jsCssIncludes.twig" %}
    </head>
    {% set bodyClass = postEvent('Template.bodyClass', 'widgetized') %}
    <body class="widgetized{{ bodyClass }}">
        {# `__transitionSwitcher-unpadded` is the Transitions context hook: this shell has no card
           padding of its own, so the switcher supplies it. #}
        <div class="widget __transitionSwitcher-unpadded">
            {{ content|raw }}
        </div>
        <div id="pageFooter">
            {{ postEvent('Template.pageFooter') }}
        </div>
    </body>
</html>
