<!DOCTYPE html>
<html id="ng-app">
    <head>
        <meta charset="utf-8">
        <meta name="robots" content="noindex,nofollow">
        <meta name="google" content="notranslate">
        {% include "_jsGlobalVariables.twig" %}
        {% include "_jsCssIncludes.twig" %}
    </head>
    {% set bodyClass = postEvent('Template.bodyClass', 'widgetized') %}
    <body class="widgetized{{ bodyClass }}">
        {# `__reportHeader-onHover` is the ReportHeader context hook, carried here so the report's
           actions trigger darkens once the pointer is on the widget. This context renders no
           widget controls, so the hook's other half has nothing to hide. #}
        <div class="widget __reportHeader-onHover">
            {{ content|raw }}
        </div>
        <div id="pageFooter">
            {{ postEvent('Template.pageFooter') }}
        </div>
    </body>
</html>
