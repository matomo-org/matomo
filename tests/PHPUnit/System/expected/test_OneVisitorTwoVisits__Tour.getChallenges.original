a:19:{i:0;a:6:{s:2:"id";s:10:"track_data";s:4:"name";s:21:"Embed a tracking code";s:11:"description";s:127:"Matomo offers you various ways to embed the tracking code for your website, mobile app, and even for any device or application.";s:11:"isCompleted";b:1;s:9:"isSkipped";b:0;s:3:"url";s:59:"index.php?module=CoreAdminHome&action=trackingCodeGenerator";}i:1;a:6:{s:2:"id";s:11:"define_goal";s:4:"name";s:10:"Add a goal";s:11:"description";s:237:"Conversion tracking is a great way to identify whether you are meeting your current objectives, to identify new ones, view and analyse performance. You can also learn to increase your conversions, conversion rates, and revenue per visit.";s:11:"isCompleted";b:0;s:9:"isSkipped";b:0;s:3:"url";s:36:"index.php?module=Goals&action=manage";}i:2;a:6:{s:2:"id";s:11:"custom_logo";s:4:"name";s:16:"Upload your logo";s:11:"description";s:98:"You can customize the Matomo logo which will be displayed in the user interface and email reports.";s:11:"isCompleted";b:0;s:9:"isSkipped";b:0;s:3:"url";s:69:"index.php?module=CoreAdminHome&action=generalSettings#/#useCustomLogo";}i:3;a:6:{s:2:"id";s:8:"add_user";s:4:"name";s:13:"Invite a user";s:11:"description";s:115:"Users Management lets you add new users, edit existing users and give them access to view or administrate websites.";s:11:"isCompleted";b:0;s:9:"isSkipped";b:0;s:3:"url";s:42:"index.php?module=UsersManager&action=index";}i:4;a:6:{s:2:"id";s:11:"add_website";s:4:"name";s:19:"Add another website";s:11:"description";s:74:"Websites management lets you add a new website and edit existing websites.";s:11:"isCompleted";b:1;s:9:"isSkipped";b:0;s:3:"url";s:42:"index.php?module=SitesManager&action=index";}i:5;a:6:{s:2:"id";s:15:"flatten_actions";s:4:"name";s:21:"Flatten a page report";s:11:"description";s:151:"Go to Behaviour → Pages and click the cog icon in the bottom of the report to flatten it. This changes the hierarchy from a grouped report to a list.";s:11:"isCompleted";b:0;s:9:"isSkipped";b:0;s:3:"url";s:86:"https://matomo.org/faq/reports/graphs-and-visualisations-in-matomo/#flattening-reports";}i:6;a:6:{s:2:"id";s:21:"change_visualisations";s:4:"name";s:22:"Change a visualisation";s:11:"description";s:104:"Browse a report and select the visualisation icon at the bottom of a report to change its visualisation.";s:11:"isCompleted";b:0;s:9:"isSkipped";b:0;s:3:"url";s:67:"https://matomo.org/faq/reports/graphs-and-visualisations-in-matomo/";}i:7;a:6:{s:2:"id";s:20:"add_scheduled_report";s:4:"name";s:22:"Add a scheduled report";s:11:"description";s:167:"Create custom reports and schedule them to be emailed daily, weekly or monthly to one or several people. Several report formats are supported (html, pdf, csv, images).";s:11:"isCompleted";b:0;s:9:"isSkipped";b:0;s:3:"url";s:46:"index.php?module=ScheduledReports&action=index";}i:8;a:6:{s:2:"id";s:19:"customise_dashboard";s:4:"name";s:21:"Set up your dashboard";s:11:"description";s:83:"Add widgets to your dashboard to ensure it reports all your most important metrics.";s:11:"isCompleted";b:0;s:9:"isSkipped";b:0;s:3:"url";s:85:"https://matomo.org/faq/dashboards/create-dashboards-and-customise-widgets-and-layout/";}i:9;a:6:{s:2:"id";s:11:"add_segment";s:4:"name";s:13:"Add a segment";s:11:"description";s:158:"A segment is a set of criteria used to select only a part of the entire set of visits. Using segments you can inject arbitrary context back into your reports.";s:11:"isCompleted";b:0;s:9:"isSkipped";b:0;s:3:"url";s:37:"https://matomo.org/docs/segmentation/";}i:10;a:6:{s:2:"id";s:14:"add_annotation";s:4:"name";s:17:"Add an annotation";s:11:"description";s:265:"Allows you to attach notes to different days to mark changes made to your website, save analyses you make regarding your data and share your thoughts with your colleagues. By annotating your data, you will make sure you remember why your data looks the way it does.";s:11:"isCompleted";b:0;s:9:"isSkipped";b:0;s:3:"url";s:36:"https://matomo.org/docs/annotations/";}i:11;a:6:{s:2:"id";s:11:"setup_twofa";s:4:"name";s:31:"Setup Two-factor authentication";s:11:"description";s:193:"Two-factor authentication increases account security by also asking you for a code generated on a mobile device, or one of the remaining recovery codes (in addition to your password) to log in.";s:11:"isCompleted";b:0;s:9:"isSkipped";b:0;s:3:"url";s:40:"https://matomo.org/faq/general/faq_27245";}i:12;a:6:{s:2:"id";s:25:"disable_browser_archiving";s:4:"name";s:53:"Turn off web-browser archiving for better performance";s:11:"description";s:0:"";s:11:"isCompleted";b:0;s:9:"isSkipped";b:0;s:3:"url";s:45:"https://matomo.org/docs/setup-auto-archiving/";}i:13;a:6:{s:2:"id";s:21:"configure_geolocation";s:4:"name";s:18:"Set up geolocation";s:11:"description";s:59:"Ensure the location of your visitors is correctly detected.";s:11:"isCompleted";b:0;s:9:"isSkipped";b:0;s:3:"url";s:46:"index.php?module=UserCountry&action=adminIndex";}i:14;a:6:{s:2:"id";s:17:"select_date_range";s:4:"name";s:19:"Select a date range";s:11:"description";s:35:"Select a time span in the calendar.";s:11:"isCompleted";b:0;s:9:"isSkipped";b:0;s:3:"url";s:56:"https://matomo.org/faq/reports/data-selectors-in-matomo/";}i:15;a:6:{s:2:"id";s:15:"view_visits_log";s:4:"name";s:15:"View Visits Log";s:11:"description";s:78:"Shows all the individual visits and actions each visitor made on your website.";s:11:"isCompleted";b:0;s:9:"isSkipped";b:0;s:3:"url";s:53:"https://matomo.org/faq/reports/the-visits-log-report/";}i:16;a:6:{s:2:"id";s:20:"view_visitor_profile";s:4:"name";s:20:"View Visitor profile";s:11:"description";s:99:"Understand your visitors’ individual behavior by summarizing and listing your visitors’ visits.";s:11:"isCompleted";b:0;s:9:"isSkipped";b:0;s:3:"url";s:37:"https://matomo.org/docs/user-profile/";}i:17;a:6:{s:2:"id";s:18:"view_row_evolution";s:4:"name";s:18:"View Row evolution";s:11:"description";s:65:"Shows the current and past metric data for any row in any report.";s:11:"isCompleted";b:0;s:9:"isSkipped";b:0;s:3:"url";s:38:"https://matomo.org/docs/row-evolution/";}i:18;a:6:{s:2:"id";s:18:"browse_marketplace";s:4:"name";s:22:"Browse the marketplace";s:11:"description";s:100:"Extend and expand the functionality of Matomo via the Marketplace by downloading plugins and themes.";s:11:"isCompleted";b:0;s:9:"isSkipped";b:0;s:3:"url";s:44:"index.php?module=Marketplace&action=overview";}}